# Kopiere nach .env und trage deine Alpaca-PAPER-Keys ein. .env ist git-ignoriert.
ALPACA_API_KEY_ID=
# (auch ALPACA_API_KEY / ALPACA_SECRET_KEY werden gelesen)
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Wie viel des gemeinsamen Paper-Kontos der Bot verwenden darf (Standard 50000)
CP_BUDGET=50000
